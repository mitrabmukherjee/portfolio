// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Case Details
  styleOfCause       String?
  crownCounselName   String?
  defenceCounselName String?
  courtFileNumber    String?
  courtLocation      String?

  // Additional Details About the Order
  preferredACT           String?
  copyType               String?
  numberOfCopies         Int?
  emailCopy              String?
  quoteRequired          String?
  dueDate                String?
  preferredContactMethod String?
  additionalComments     String?
  usedForAppeal          String?
  appealNumber           String?

  // Ordering Party Details
  orderingPartyName String?
  companyName       String?
  designation       String?
  streetAddress     String?
  city              String?
  province          String?
  postalCode        String?
  officeNumber      String?
  cellNumber        String?
  emailAddress      String?

  // Relation to proceeding dates
  proceedingDates ProceedingDate[]
}

model ProceedingDate {
  id          String  @id @default(cuid())
  date        String?
  justiceName String?
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Contact {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Required Fields
  fullName String
  phone    String
  email    String

  // Optional Fields
  requirement String?
  comments    String?
}
